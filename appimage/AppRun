#!/bin/bash
# RIT.AppImage entry point. Same single-master / clean-teardown model as the Mac
# launcher: run RIT in the foreground, then kill the whole Wine session so no
# wineserver/services.exe linger.
set -u
HERE="$(dirname "$(readlink -f "$0")")"

export WINELOADER="$HERE/usr/bin/wine"
export WINESERVER="$HERE/usr/bin/wineserver"
export PATH="$HERE/usr/bin:$PATH"
export LD_LIBRARY_PATH="$HERE/usr/lib:$HERE/usr/lib/x86_64-linux-gnu:$HERE/usr/lib/i386-linux-gnu:${LD_LIBRARY_PATH:-}"
export WINEDLLPATH="$HERE/usr/lib/wine"

export WINEARCH=win32
export WINEDEBUG=-all
export WINEDLLOVERRIDES="mscoree=n;mshtml=d"

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/RIT"
export WINEPREFIX="$DATA/prefix"
mkdir -p "$DATA"

# First run: copy the bundled prefix into a writable location.
if [ ! -f "$WINEPREFIX/.rit-ready" ]; then
    echo "First run: setting up RIT (one-time)..." >&2
    rm -rf "$WINEPREFIX"
    cp -a "$HERE/rit-prefix" "$WINEPREFIX"
    touch "$WINEPREFIX/.rit-ready"
fi

CLIENT="$WINEPREFIX/drive_c/Program Files/Rotman/RIT User Application/Client.exe"

# Bulletproof teardown. Run the whole Wine session inside a PID namespace: if this
# launcher dies for ANY reason — normal exit, window close, SIGTERM, or even a
# Force Quit / `kill -9` — the kernel SIGKILLs EVERY process in the namespace
# (wineserver, services.exe, plugplay, explorer… all of it). No lingering or
# hidden background process can survive. Verified: 0 survivors after SIGKILL.
#   --user --map-current-user : rootless; Wine stays your uid, prefix still owned
#                               by it (ownership check passes), no root warning.
#   --pid --fork              : new PID namespace; Wine becomes its init (PID 1).
#   --kill-child              : ties the namespace's death to this launcher's
#                               (parent-death signal) — covers the SIGKILL case.
NS="unshare --user --map-current-user --pid --fork --kill-child --mount-proc"
if $NS true 2>/dev/null; then
    exec $NS -- "$WINELOADER" "$CLIENT" "$@"
else
    # Hardened kernels may disable unshare/user namespaces — fall back to a
    # best-effort wineserver -k on exit (covers everything but Force Quit).
    cleanup() { "$WINESERVER" -k >/dev/null 2>&1 || true; }
    trap cleanup EXIT INT TERM HUP
    "$WINELOADER" "$CLIENT" "$@"
fi
