# Runtime Wine prefix / container volume (huge, machine-specific, may hold secrets)
config/

# Proprietary RIT client binary + decompiled source — do NOT publish (Rotman copyright)
decomp/

# Upstream Wine source checkouts — the build Dockerfiles clone these themselves
wine-src/
wine-77-src/
gptk-src/
gptk-build/src/

# Build outputs (regenerated by the build Dockerfiles)
arm-build/out/
arm-build/out-*/
wine-build/out/
wine-build/out_min/
gptk-build/out/
appimage/out/

# cached MSI fetched by the gate workflow / local tests
test/rit.msi
**/rit.msi

# Local env (ship .env.example instead)
.env

# Logs
*.log

# Claude Code harness state
.claude/

# --- from rit-on-mac (Mac build) ---
# Build outputs
work/
.work/
out/
*.pkg
*.dmg

# Local test rig (developer-only; never shipped to students)
overrides.conf
*.creds
autotype
rit-autotype
*.local
*.local.*

# macOS junk
.DS_Store
