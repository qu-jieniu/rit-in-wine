<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for RIT.app (v2). Signed with Developer ID + hardened runtime.
  - hypervisor: libkrun boots the microVM via Hypervisor.framework.
  - allow-jit / unsigned-executable-memory: FEX JIT-translates x86 -> arm64
    inside the guest; required or FEX won't run after notarization.
  - disable-library-validation: load libkrun + bundled dylibs.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.hypervisor</key><true/>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
</dict>
</plist>
