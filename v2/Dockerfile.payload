# v2 container payload: RIT (stock Wine 11, no patch) + a web desktop (noVNC).
# amd64 image — runs natively on x86, and under FEX in an arm64 microVM on a Mac.
# The macOS v2 wrapper (Apple Containerization / libkrun) runs this and shows the
# noVNC desktop in a native window.
ARG BASE=rit-prefix:installed
FROM ${BASE}

RUN apt-get update && apt-get install -y --no-install-recommends \
        x11vnc novnc websockify openbox iproute2 ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY rit-desktop.sh /usr/local/bin/rit-desktop
RUN chmod +x /usr/local/bin/rit-desktop

EXPOSE 6080 9999
ENTRYPOINT ["/usr/local/bin/rit-desktop"]
